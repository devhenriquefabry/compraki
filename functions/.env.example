# ============================================================
# COMPRAKI — Variáveis de Ambiente das Cloud Functions
# ============================================================
# Copie este arquivo para functions/.env e preencha com seus valores reais.
# NUNCA commite o arquivo .env com dados reais!
#
#   cp functions/.env.example functions/.env
# ============================================================

# ----------------------------------------------------------
# EVOLUTION API (WhatsApp)
# ----------------------------------------------------------

# URL base da sua instância da Evolution API
# Exemplo: https://sua-instancia.up.railway.app
EVOLUTION_API_URL=

# Chave global de autenticação da Evolution API
# Defina no painel da Evolution API > Global API Key
EVOLUTION_API_KEY=

# Instancia padrao usada como fallback quando /instance/fetchInstances falhar.
# Pode ser uma lista separada por virgula.
EVOLUTION_DEFAULT_INSTANCE=

# WhatsApp que recebe notificacoes administrativas de novos cadastros.
WHATSAPP_SIGNUP_NOTIFY_PHONE=

# Segredo para validação de webhooks da Evolution API (opcional)
EVOLUTION_WEBHOOK_SECRET=

# Origens permitidas para CORS. Em produção, liste os domínios de verdade:
# a primeira da lista é a resposta padrão quando a origem não bate com nenhuma.
# `ALLOWED_ORIGIN=*` serve só em desenvolvimento.
ALLOWED_ORIGINS=https://www.vineonsite.com.br,https://vineonsite.com.br,capacitor://localhost,ionic://localhost

# Endereço público do site, usado nos redirects de volta de fluxos OAuth
# (ex.: callback do Melhor Envio). Sem barra no final.
APP_PUBLIC_URL=https://www.vineonsite.com.br

# ----------------------------------------------------------
# SMTP — Envio de E-mail (recuperação de senha)
# ----------------------------------------------------------

# Host do servidor SMTP
# Gmail: smtp.gmail.com
SMTP_HOST=smtp.gmail.com

# Porta SMTP (587 para TLS, 465 para SSL)
SMTP_PORT=587

# Use "true" para SSL direto (porta 465), "false" para STARTTLS (porta 587)
SMTP_SECURE=false

# E-mail remetente (sua conta Gmail ou outro provedor)
SMTP_USER=

# Senha de app do Gmail (não a senha normal da conta!)
# Gere em: https://myaccount.google.com/apppasswords
SMTP_PASS=

# ----------------------------------------------------------
# ADMIN
# ----------------------------------------------------------

# E-mails com privilégios de administrador (separados por vírgula)
ADMIN_EMAILS=

# Token de bootstrap do PRIMEIRO administrador.
# Gere um valor aleatorio longo, use uma vez para chamar `bootstrapAdminClaims`
# e APAGUE esta linha em seguida, refazendo o deploy.
#   openssl rand -hex 32
ADMIN_BOOTSTRAP_TOKEN=

# ----------------------------------------------------------
# ASAAS — Pagamentos
# ----------------------------------------------------------
# A chave de producao ficava dentro do bundle do app (src/app/services/
# asaas.service.ts) e no historico do Git. Foi revogada; a nova vive SO aqui.
# Nunca colocar essa chave em nenhum arquivo sob src/.
ASAAS_API_KEY=

# O Asaas processa so CARTAO. PIX e boleto saem pelo Cora (bloco abaixo).
# Base da API. Producao: https://api.asaas.com/v3
# Sandbox:            https://api-sandbox.asaas.com/v3 (conta separada,
#                     criada em https://sandbox.asaas.com; chave $aact_hmlg_...)
ASAAS_API_URL=https://api.asaas.com/v3

# Token do webhook de pagamento. Cadastre o MESMO valor no painel do Asaas em
# Integracoes > Webhooks; ele chega no cabecalho `asaas-access-token`. Sem ele,
# a funcao `asaasWebhook` recusa tudo — e sem o webhook nenhum pedido de PIX ou
# boleto sai de PENDING, porque confirmar pagamento deixou de ser coisa do app.
#   openssl rand -hex 32
ASAAS_WEBHOOK_TOKEN=

# ----------------------------------------------------------
# CORA — PIX e boleto (Integracao Direta, mTLS)
# ----------------------------------------------------------
# stage = sandbox | production = dinheiro de verdade. Cada ambiente tem o seu
# client_id + certificado + chave privada, gerados no app ou no Cora Web em
# Conta > Integracoes via APIs. Ver docs/pagamentos-sandbox.md.
CORA_ENV=stage
CORA_CLIENT_ID=
# Certificado e chave em base64, uma linha cada. Nao cole a mao — rode:
#   node scripts/cora.mjs import-cert <certificate.pem> <private-key.key>
CORA_CERTIFICATE=
CORA_PRIVATE_KEY=
# Opcional: sobrescreve a base da API (o padrao sai do CORA_ENV).
# CORA_API_URL=
# Vai na URL do webhook (?token=...), porque o Cora nao assina as notificacoes.
#   openssl rand -hex 32
# Cadastro no Cora, depois do deploy: node scripts/cora.mjs webhooks register
CORA_WEBHOOK_TOKEN=

# ----------------------------------------------------------
# MELHOR ENVIO
# ----------------------------------------------------------
# Segredo compartilhado do webhook. Sem ele a funcao `melhorEnvioWebhook`
# recusa toda requisicao — antes ela aceitava qualquer POST e escrevia
# direto em `orders`.
MELHOR_ENVIO_WEBHOOK_SECRET=
