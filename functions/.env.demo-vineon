# Carregado SO quando as functions rodam no projeto `demo-vineon`, ou seja, no
# emulador local (npm run emulators). Sobrepoe o que vier de `.env`.
# Nada de segredo aqui: este arquivo vai para o git de proposito.
#
# Objetivo: teste local nunca fala com o mundo real por engano.

# Sem SMTP: recuperacao de senha nao manda e-mail (o codigo sai no log).
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# Sem Evolution: nada de WhatsApp (aviso de cadastro, bots). As telas de bots
# respondem "Evolution API nao configurada", e esta certo que seja assim.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_DEFAULT_INSTANCE=
WHATSAPP_SIGNUP_NOTIFY_PHONE=

# Pagamentos travados em sandbox, mesmo que o `.env` volte para producao um dia.
# Com chave de producao isso so falha, nunca cobra.
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
CORA_ENV=stage

# O app do emulador roda em http://localhost:4210 (ng serve --configuration emulator).
ALLOWED_ORIGINS=http://localhost:4210,http://127.0.0.1:4210
APP_PUBLIC_URL=http://localhost:4210

# Admin no emulador vem do claim gravado pelo seed, nao desta lista.
ADMIN_EMAILS=
ADMIN_BOOTSTRAP_TOKEN=
