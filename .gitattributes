# Normaliza fim de linha: o repositorio guarda LF, o Windows continua com CRLF
# na arvore de trabalho. Sem isto, cada maquina reescrevia arquivo inteiro.
* text=auto

# Binarios: nunca converter.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.jks binary
*.keystore binary
