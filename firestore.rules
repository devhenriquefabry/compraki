rules_version = '2';

// ============================================================================
// Vineon / Compraki — regras de acesso ao Firestore
//
// PRINCIPIOS (nao afrouxar sem revisao):
//  1. Papel de admin vem EXCLUSIVAMENTE do custom claim `admin` no ID token.
//     Nunca de campo em documento que o proprio usuario possa escrever.
//  2. `users/{uid}` guarda dado pessoal (CPF, telefone, endereco) e NAO tem
//     leitura publica. O perfil publico do vendedor vive em `sellers/{uid}`,
//     espelhado por Cloud Function (functions/src/seller-profile.ts).
//  3. Toda regra de update valida `resource.data` (o documento que ja existe),
//     nao apenas `request.resource.data` (o payload que chegou).
//  4. Colecao sem match explicito é negada por padrao. Ao criar colecao nova,
//     adicionar a regra aqui — nao pelo console.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Somente custom claim. Ver functions/src/admin-claims.ts para atribuir.
    // `get` com padrao: quem nao e admin nao tem o campo no token, e ler
    // `token.admin` direto dava erro ("Property admin is undefined") e
    // derrubava a regra inteira em consultas como "minhas vendas".
    function isAdmin() {
      return isSignedIn() && request.auth.token.get('admin', false) == true;
    }

    // Campos que definem privilegio ou punicao: so admin encosta.
    function privilegedFields() {
      return ['isAdmin', 'super_admin', 'role', 'admin', 'isChatBanned', 'suspended'];
    }

    // Conta derrubada pelo admin (`setAccountSuspension`). O login ja fica
    // bloqueado no Auth, mas um ID token emitido antes continua valido por ate
    // 1 hora — por isso as escritas que importam conferem aqui tambem.
    function isSuspended() {
      return exists(/databases/$(database)/documents/accountSuspensions/$(request.auth.uid));
    }

    function touchesPrivileged() {
      return request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny(privilegedFields());
    }

    function chatData(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data;
    }

    function isChatParticipant(chatId) {
      let c = chatData(chatId);
      return isSignedIn() && (
        (c.participantIds is list && request.auth.uid in c.participantIds) ||
        request.auth.uid == c.buyerId ||
        request.auth.uid == c.sellerId
      );
    }

    // ---------------------------------------------------------------- produtos

    // Nota e contagem de avaliacoes: so a Cloud Function `onProductReviewWritten`
    // escreve. Com isso liberado, o vendedor gravava `rating: 5` no proprio anuncio.
    function reviewAggregateFields() {
      return ['rating', 'reviewCount', 'ratingBreakdown', 'reviewPhotoCount', 'listingMatch'];
    }

    // Campos que o vendedor nao escreve: nota agregada (funcao de avaliacoes) e
    // `moderation` (anuncio fora do ar — admin e funcao `moderateProductName`).
    function sellerLockedProductFields() {
      return reviewAggregateFields().concat(['moderation']);
    }

    match /products/{productId} {
      allow read: if true;

      allow create: if isAdmin() || (
        isSignedIn()
        && request.resource.data.sellerId == request.auth.uid
        && !request.resource.data.keys().hasAny(sellerLockedProductFields())
        && !isSuspended()
      );

      // Valida o dono ATUAL do documento e impede transferir a posse.
      allow update: if isAdmin() || (
        isSignedIn()
        && resource.data.sellerId == request.auth.uid
        && request.resource.data.sellerId == resource.data.sellerId
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(sellerLockedProductFields())
        && !isSuspended()
      );

      allow delete: if isAdmin() || (
        isSignedIn() && resource.data.sellerId == request.auth.uid
      );

      // Avaliacoes. Id do documento = uid de quem avalia (uma por pessoa).
      // Leitura publica: visitante sem conta tambem ve as opinioes.
      //
      // A regra garante que o pedido citado e da pessoa e ja foi ENTREGUE
      // (como no ML e na Shopee: so se avalia o que chegou). Se o produto esta
      // mesmo dentro do pedido quem confere e a funcao `onProductReviewWritten`
      // (a regra nao consegue varrer `items`); se nao estiver, ela apaga.
      //
      // Campos do autor: reviewClientFields(). Campos do servidor (selo de
      // compra, loja, "util", resposta da loja): so a funcao ou a loja dona do
      // produto (apenas `sellerReply`) escrevem.
      match /reviews/{reviewerId} {
        allow read: if true;

        allow create: if isUser(reviewerId)
          && !isSuspended()
          && request.resource.data.keys().hasOnly(reviewClientFields())
          && isValidReview()
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && ownsDeliveredOrder(request.resource.data.orderId)
          && get(/databases/$(database)/documents/products/$(productId)).data.sellerId != request.auth.uid;

        // Autor editando: so os campos dele; pedido e data de criacao fixos.
        allow update: if isUser(reviewerId)
          && !isSuspended()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(reviewClientFields())
          && isValidReview()
          && request.resource.data.orderId == resource.data.orderId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;

        // Loja dona do produto respondendo (uma resposta, editavel/removivel).
        allow update: if isSignedIn()
          && !isSuspended()
          && get(/databases/$(database)/documents/products/$(productId)).data.sellerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sellerReply'])
          && (!('sellerReply' in request.resource.data)
              || isValidSellerReply(request.resource.data.sellerReply));

        allow delete: if isUser(reviewerId) || isAdmin();
      }

      // "Esta avaliacao foi util": um documento por pessoa por produto com os
      // ids (uid do autor) das avaliacoes que ela marcou. A contagem
      // `helpfulCount` da avaliacao e escrita so pela funcao `onReviewVotesWritten`.
      match /reviewVotes/{voterId} {
        allow read, delete: if isUser(voterId);
        allow create, update: if isUser(voterId)
          && !isSuspended()
          && request.resource.data.keys().hasOnly(['reviewIds', 'updatedAt'])
          && request.resource.data.reviewIds is list
          && request.resource.data.reviewIds.size() <= 200
          && request.resource.data.updatedAt == request.time;
      }
    }

    // "Minhas avaliacoes" e "Avaliacoes da loja" consultam todas as avaliacoes
    // de uma pessoa / de uma loja (collection group). Mesma leitura publica.
    match /{path=**}/reviews/{reviewerId} {
      allow read: if true;
    }

    function reviewClientFields() {
      return ['userId', 'userName', 'rating', 'comment', 'orderId', 'createdAt', 'updatedAt',
              'photos', 'matchesListing'];
    }

    // Valida o documento inteiro como fica depois da escrita. Campos do
    // servidor podem existir (vieram da funcao), mas o autor nao os altera:
    // isso e garantido pelo hasOnly() das regras de create/update.
    function isValidReview() {
      let d = request.resource.data;
      return d.userId == request.auth.uid
        && d.rating is int && d.rating >= 1 && d.rating <= 5
        && d.comment is string && d.comment.size() <= 2000
        && d.userName is string && d.userName.size() <= 60
        && d.orderId is string
        && (!('photos' in d) || (d.photos is list && d.photos.size() <= 5))
        && (!('matchesListing' in d) || d.matchesListing == null
            || d.matchesListing in ['yes', 'partly', 'no']);
    }

    function isValidSellerReply(r) {
      return r is map
        && r.keys().hasOnly(['text', 'createdAt', 'updatedAt'])
        && r.text is string && r.text.size() >= 2 && r.text.size() <= 1000
        && r.createdAt is timestamp
        && r.updatedAt == request.time;
    }

    // Pedido da pessoa, pago e ja entregue (a loja marcou ou o comprador
    // confirmou o recebimento). Mesma regra de `orderStage() == 'done'`.
    function ownsDeliveredOrder(orderId) {
      let order = get(/databases/$(database)/documents/orders/$(orderId)).data;
      return order.userId == request.auth.uid
        && order.status in ['RECEIVED', 'CONFIRMED', 'DELIVERED', 'IN_ESCROW']
        && (order.status == 'DELIVERED' || order.get('shipmentStatus', '') == 'DELIVERED');
    }

    // ------------------------------------------------------ catalogo editorial

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Catalogo Vineon: fichas prontas (fotos, ficha tecnica, variacoes) que o
    // admin monta na aba Catalogo e o vendedor usa para anunciar. Leitura
    // publica — o vendedor busca e a ficha do anuncio mostra o selo. Rascunho
    // nao tem nada sensivel; o app so esconde do vendedor.
    match /catalogProducts/{catalogId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Ajustes que o admin muda pelo painel (aba Ajustes): frete gratis por
    // valor, termos proibidos em anuncio, redes sociais. Leitura publica — a
    // vitrine de visitante precisa. NUNCA guardar segredo aqui (isso e `settings/`).
    match /appConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ------------------------------------------------- perfil publico de loja
    // Espelho somente-leitura mantido pela Cloud Function `syncSellerProfile`.
    // Contem apenas campos de vitrine — nunca CPF, e-mail, telefone ou endereco.

    match /sellers/{sellerId} {
      allow read: if true;
      allow write: if false;
    }

    // ------------------------------------------------------------- usuarios
    // Dado pessoal. Leitura restrita ao dono e a admin.

    match /users/{userId} {
      allow read: if isUser(userId) || isAdmin();

      allow create: if isAdmin() || (
        isUser(userId)
        && !request.resource.data.keys().hasAny(privilegedFields())
      );

      allow update: if isAdmin() || (
        isUser(userId) && !touchesPrivileged()
      );

      allow delete: if isAdmin();

      // Seguidores: contagem aparece no perfil publico, entao leitura aberta.
      // O documento so guarda o vinculo, sem dado pessoal.
      match /followers/{followerId} {
        allow read: if true;
        allow create, update, delete: if isUser(followerId)
          && request.auth.uid != userId;
      }

      match /followingSellers/{sellerId} {
        allow read: if isUser(userId) || isAdmin();
        allow create, update, delete: if isUser(userId)
          && request.auth.uid != sellerId;
      }

      // Carrinho, salvos e enderecos: exclusivos do dono.
      match /cart/{itemId} {
        allow read, write: if isUser(userId);
      }

      match /savedProducts/{savedId} {
        allow read, write: if isUser(userId);
      }

      match /addresses/{addressId} {
        allow read, write: if isUser(userId);
      }

      // Avisos (tela Notificacoes). Quem cria e a Cloud Function
      // (functions/src/notifications.ts); o dono so marca como lido e apaga.
      match /notifications/{notificationId} {
        allow read, delete: if isUser(userId);
        allow update: if isUser(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      }

      // Inscricao de push de cada aparelho (PWA instalado). O ID e o hash do
      // endpoint; a function apaga as que o servico de push der como mortas.
      match /pushSubscriptions/{subscriptionId} {
        allow read, delete: if isUser(userId);
        allow create, update: if isUser(userId)
          && request.resource.data.endpoint is string
          && request.resource.data.endpoint.matches('https://.+')
          && request.resource.data.keys.p256dh is string
          && request.resource.data.keys.auth is string;
      }
    }

    // ------------------------------------------------ consultas collection group
    // `collectionGroup()` NAO usa as regras da subcolecao: precisa de match
    // proprio com o prefixo `{path=**}`. Sao consultas de painel, so admin.
    //
    // NOTA: `StatsService.countSaves()` (src/app/services/stats.service.ts)
    // faz collectionGroup em `savedProducts` e passa a devolver 0 para o
    // vendedor comum — o try/catch de la ja trata. A correcao definitiva e o
    // contador desnormalizado `savedCount` no proprio produto (Fase 2).

    match /{path=**}/messages/{messageId} {
      allow read: if isAdmin();
    }

    match /{path=**}/savedProducts/{savedId} {
      allow read: if isAdmin();
    }

    // ---------------------------------------------------------------- chats

    match /chats/{chatId} {
      // `get` com padrao em vez de ler o campo direto: numa consulta ("minhas
      // conversas") o motor nao conhece os outros campos, e um campo ausente
      // dava erro e derrubava a regra inteira.
      allow read: if isAdmin() || (isSignedIn() && (
        request.auth.uid in resource.data.get('participantIds', []) ||
        request.auth.uid == resource.data.get('buyerId', null) ||
        request.auth.uid == resource.data.get('sellerId', null)
      ));

      // Quem cria precisa estar dentro da propria conversa.
      allow create: if isAdmin() || (
        isSignedIn()
        && request.resource.data.participantIds is list
        && request.auth.uid in request.resource.data.participantIds
      );

      allow update: if isAdmin() || (isSignedIn() && (
        (resource.data.participantIds is list
          && request.auth.uid in resource.data.participantIds) ||
        request.auth.uid == resource.data.buyerId ||
        request.auth.uid == resource.data.sellerId
      ));

      allow delete: if isAdmin();

      // Subcolecao NAO herda a regra do pai — a checagem precisa ser repetida.
      match /messages/{messageId} {
        allow read: if isAdmin() || isChatParticipant(chatId);

        allow create: if isAdmin() || (
          isChatParticipant(chatId)
          && request.resource.data.senderId == request.auth.uid
          && !isSuspended()
        );

        // Mensagem enviada nao se reescreve; historico e imutavel.
        allow update: if isAdmin() || (
          isChatParticipant(chatId)
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['read', 'readAt'])
        );

        allow delete: if isAdmin();
      }
    }

    // --------------------------------------------------------------- pedidos
    // Leitura para o comprador, para os vendedores envolvidos e para admin.
    // Valores financeiros so mudam via Cloud Function (Admin SDK ignora regras).

    match /orders/{orderId} {
      function isBuyer() {
        return request.auth.uid == resource.data.userId;
      }

      function isOrderSeller() {
        return resource.data.sellerIds is list && request.auth.uid in resource.data.sellerIds;
      }

      function changedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      // Datas de envio e entrega so podem ser "agora" (hora do servidor). O
      // prazo de desistencia do comprador (7 dias do recebimento, CDC art. 49)
      // e a liberacao do repasse contam delas: ninguem volta o relogio para
      // encurtar o prazo. Confirmar o recebimento e coisa do comprador.
      function deliveryStampsAreNow() {
        let keys = changedKeys();
        let data = request.resource.data;
        return (!keys.hasAny(['deliveredAt']) || data.deliveredAt == request.time)
          && (!keys.hasAny(['shippedAt']) || data.shippedAt == request.time)
          && (!keys.hasAny(['shipmentProblemAt']) || data.shipmentProblemAt == request.time)
          && (!keys.hasAny(['deliveryConfirmedAt'])
              || (isBuyer() && data.deliveryConfirmedAt == request.time));
      }

      // Pedido de devolucao: so o comprador, uma vez, em pedido pago com o
      // valor ainda retido, e so com status REQUESTED. Aprovar, recusar e
      // concluir o estorno e do admin.
      function isRefundRequest() {
        let after = request.resource.data.refundInfo;
        return isBuyer()
          && resource.data.get('refundInfo', {}).get('status', null) == null
          && resource.data.status in ['RECEIVED', 'CONFIRMED', 'DELIVERED', 'IN_ESCROW']
          && resource.data.get('escrowInfo', {}).get('status', 'HOLDING') == 'HOLDING'
          && after.keys().hasOnly(['status', 'reason', 'requestedAt', 'requestedBy'])
          && after.status == 'REQUESTED'
          && after.requestedBy == request.auth.uid
          && after.reason is string
          && after.reason.size() >= 10
          && after.reason.size() <= 1000
          && after.requestedAt == request.time;
      }

      // Cupom no pedido: tem que ser copia exata da reserva que `couponQuote`
      // gravou para esta pessoa, ainda aberta e dentro do prazo. O desconto e
      // calculado no servidor; o navegador so repete o que recebeu.
      function couponMatchesReservation() {
        let c = request.resource.data.coupon;
        let r = get(/databases/$(database)/documents/couponRedemptions/$(c.redemptionId)).data;
        return c.keys().hasOnly(['redemptionId', 'code', 'scope', 'sellerId', 'type',
                                 'discount', 'itemsDiscount', 'shippingDiscount'])
          && r.uid == request.auth.uid
          && r.status == 'reserved'
          && r.expiresAt > request.time
          && c.code == r.code
          && c.scope == r.scope
          && c.sellerId == r.sellerId
          && c.type == r.type
          && c.discount == r.discount
          && c.itemsDiscount == r.itemsDiscount
          && c.shippingDiscount == r.shippingDiscount;
      }

      // `get` com padrao: na consulta "minhas vendas" (sellerIds contem eu) o
      // motor nao conhece `userId`, e ler o campo direto dava erro e negava a
      // lista inteira.
      allow read: if isAdmin() || (isSignedIn() && (
        request.auth.uid == resource.data.get('userId', null) ||
        request.auth.uid in resource.data.get('sellerIds', [])
      ));

      // O pedido nasce esperando pagamento e com o valor retido. Quem diz que
      // foi pago e o webhook (Admin SDK); devolucao, entrega e repasse vem
      // depois, cada um por quem pode.
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && !isSuspended()
        && request.resource.data.status == 'PENDING'
        && request.resource.data.get('escrowInfo', {}).get('status', 'HOLDING') == 'HOLDING'
        && !request.resource.data.keys().hasAny([
             'refundInfo', 'paymentAlert', 'paymentConfirmedAt', 'paymentConfirmedBy',
             'shipmentStatus', 'shippedAt', 'deliveredAt', 'deliveryConfirmedAt',
             'shipmentProblemAt', 'fiscalDocuments', 'couponCheck', 'couponCheckReason'
           ])
        && (!request.resource.data.keys().hasAny(['coupon']) || couponMatchesReservation());

      // Comprador e vendedor mexem em entrega e observacao, nunca no dinheiro
      // nem no `status`.
      //
      // `status` esta na lista porque e ele que diz se o pedido foi pago. Com
      // ele liberado, o comprador escrevia `status: 'RECEIVED'` direto pelo SDK
      // e levava o produto sem pagar - era o que o botao "SIMULAR PAGAMENTO"
      // fazia. Quem confirma pagamento e a funcao `asaasWebhook`, pelo Admin
      // SDK, que nao passa por estas regras.
      //
      // `escrowInfo` (retencao/repasse) e so do admin: com ele aberto, o
      // vendedor podia marcar o proprio repasse como liberado pelo SDK.
      allow update: if isAdmin() || (isSignedIn()
        && (isBuyer() || isOrderSeller())
        && !changedKeys().hasAny([
             'total', 'userId', 'sellerIds', 'items', 'asaasPaymentId',
             'coraInvoiceId', 'paymentProvider',
             'status', 'paymentAlert', 'paymentConfirmedAt', 'paymentConfirmedBy',
             'escrowInfo', 'coupon', 'couponCheck', 'couponCheckReason'
           ])
        && (!changedKeys().hasAny(['refundInfo']) || isRefundRequest())
        // Nota fiscal / declaracao de conteudo: so a loja anexa.
        && (!changedKeys().hasAny(['fiscalDocuments']) || isOrderSeller())
        && deliveryStampsAreNow());

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------- denuncias

    // Denuncias de conversa (chat-box). A aba Conversas do admin lista tudo.
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Denuncias de anuncio e de vendedor (aba Denuncias do admin).
    // Id = `{targetType}_{targetId}_{uid}`: uma por pessoa por alvo. Quem
    // denunciou le a propria (o app mostra "voce ja denunciou"); o denunciado
    // nunca sabe quem foi.
    // Nota fiscal mensal que a Vineon emite para a loja (aba Vendedores do
    // admin). Id = `{sellerId}_{AAAA-MM}`. Só admin cria/troca/apaga; a loja
    // lê as dela e só pode marcar que abriu (`seenAt`). O status do e-mail é
    // escrito pela Cloud Function `onSellerInvoiceWritten` (Admin SDK).
    match /sellerInvoices/{invoiceId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.sellerId == request.auth.uid);

      allow create, update: if isAdmin()
        && request.resource.data.sellerId is string
        && request.resource.data.period is string
        && request.resource.data.period.matches('^[0-9]{4}-[0-9]{2}$')
        && invoiceId == request.resource.data.sellerId + '_' + request.resource.data.period;

      allow update: if isSignedIn()
        && resource.data.sellerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenAt'])
        && request.resource.data.seenAt == request.time;

      allow delete: if isAdmin();
    }

    match /contentReports/{reportId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.reporterId == request.auth.uid);

      allow create: if isSignedIn()
        && !isSuspended()
        && isValidContentReport()
        && reportId == request.resource.data.targetType + '_'
             + request.resource.data.targetId + '_' + request.auth.uid;

      allow update, delete: if isAdmin();
    }

    function isValidContentReport() {
      let d = request.resource.data;
      return d.keys().hasOnly(['targetType', 'targetId', 'sellerId', 'targetName', 'targetPhoto',
                               'reason', 'details', 'reporterId', 'reporterName', 'status', 'createdAt'])
        && d.reporterId == request.auth.uid
        && d.sellerId != request.auth.uid
        // `review`: targetId = '<produto>~<uid do autor>' e sellerId = autor
        // (quem o admin suspenderia). Ninguem denuncia a propria avaliacao.
        && d.targetType in ['product', 'seller', 'review']
        && d.targetId is string && d.targetId.size() > 0 && d.targetId.size() <= 128
        && d.sellerId is string && d.sellerId.size() > 0
        && d.targetName is string && d.targetName.size() <= 200
        && d.reason in ['prohibited', 'fraud', 'counterfeit', 'misleading', 'offensive',
                        'no_delivery', 'abusive', 'fake_profile', 'other',
                        'spam', 'off_topic', 'personal_data']
        && d.details is string && d.details.size() <= 1000
        && d.reporterName is string && d.reporterName.size() <= 80
        && d.status == 'open'
        && d.createdAt == request.time;
    }

    // ------------------------------------------------------- atendimento

    // "Fale com a Vineon". O CLIENTE SO LE: abrir atendimento, gravar mensagem
    // e mudar STATUS passam pelas functions createSupportTicket e
    // replySupportTicket, que validam, limitam abuso, numeram o protocolo e
    // definem quem e a equipe (`senderRole`). Direto pelo app so da para:
    //  - a pessoa: marcar como lido e avaliar (uma vez, depois de resolvido);
    //  - a equipe: atribuir, mudar prioridade e marcar como lido.
    // `supportCounters` (sequencia do protocolo) nao tem regra: so Admin SDK.
    function isTicketOwner(ticketId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.get('userId', null) == request.auth.uid;
    }

    function isValidCsat() {
      let c = request.resource.data.csat;
      return c is map
        && c.keys().hasOnly(['score', 'comment', 'at'])
        && c.score is int && c.score >= 1 && c.score <= 5
        && c.comment is string && c.comment.size() <= 500
        && c.at == request.time;
    }

    match /supportTickets/{ticketId} {
      // `get` com padrao: na consulta "meus atendimentos" o motor nao conhece
      // os outros campos (mesmo cuidado de `chats`).
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.get('userId', null) == request.auth.uid);

      allow create, delete: if false;

      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['assigneeId', 'assigneeName', 'priority', 'staffUnread'])
          && request.resource.data.priority in ['normal', 'high'])
        || (isSignedIn()
          && resource.data.get('userId', null) == request.auth.uid
          && (
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userUnread'])
              && request.resource.data.userUnread == false)
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['csat'])
              && resource.data.get('csat', null) == null
              && resource.data.get('status', '') in ['resolved', 'closed']
              && isValidCsat())
          ));

      // Subcolecao NAO herda a regra do pai — a checagem e repetida. Tudo
      // que a pessoa le aqui foi escrito pela function.
      match /replies/{replyId} {
        allow read: if isAdmin() || isTicketOwner(ticketId);
        allow write: if false;
      }

      // Notas internas: a pessoa nunca ve. Ficam fora de `replies` de proposito,
      // para uma consulta de lista nao poder vazar nota junto com a conversa.
      match /notes/{noteId} {
        allow read, delete: if isAdmin();
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'text', 'createdAt'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow update: if false;
      }
    }

    // Marca de conta suspensa. So a funcao `setAccountSuspension` escreve; o
    // dono le a propria.
    match /accountSuspensions/{uid} {
      allow read: if isAdmin() || isUser(uid);
      allow write: if false;
    }

    // Historico de suspensoes/reativacoes (quem, quando, por que). So o Admin SDK escreve.
    match /moderationLog/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ------------------------------------------------ operacao / diagnostico

    match /webhook_history/{entryId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Trava de idempotencia do webhook do Asaas. So o Admin SDK escreve.
    match /asaasWebhookEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Dono de cada fatura do Cora, gravado por `createCoraCharge`. So o Admin
    // SDK escreve; e por ele que o servidor confere quem pode pagar/consultar.
    match /coraCharges/{invoiceId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /whatsappMediaCache/{mediaId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /whatsappMediaCacheStats/{statsDoc} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Metricas agregadas por Cloud Function agendada (Fase 2).
    match /metrics/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ------------------------------------------------- exclusivas do Admin SDK
    // Nenhum cliente acessa. Listadas explicitamente para deixar a intencao
    // registrada, em vez de depender do deny implicito.

    match /passwordResets/{email} {
      allow read, write: if false;
    }

    match /whatsappInstances/{instanceName} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /whatsappInstanceLocks/{instanceName} {
      allow read, write: if false;
    }

    match /whatsappTriggers/{triggerId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /botJobs/{jobId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /botJobLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /whatsappDeletedInstances/{instanceName} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /whatsappTriggerLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /whatsappWebhookEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Cupons: o id e o codigo. Qualquer pessoa (ate sem conta) le os publicos
    // e ativos - aparecem na ficha do produto e em "Cupons"; a loja le os dela
    // e o admin todos. Criar, editar e usar e so pelas Cloud Functions
    // `saveCoupon` e `couponQuote` (functions/src/coupons.ts).
    match /coupons/{code} {
      allow read: if isAdmin()
        || (resource.data.visibility == 'public' && resource.data.status == 'active')
        || (isSignedIn() && resource.data.get('sellerId', null) == request.auth.uid);
      allow write: if false;
    }

    // Reservas e usos de cupom. A pessoa ve os dela; so o servidor escreve.
    match /couponRedemptions/{redemptionId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // Trava de tentativa e erro de codigo. Interno.
    match /couponAttempts/{uid} {
      allow read, write: if false;
    }

    // Credenciais e tokens de integracao (Melhor Envio, etc). Nunca ao cliente.
    match /settings/{docId} {
      allow read, write: if false;
    }
  }
}
