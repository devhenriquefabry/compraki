rules_version = '2';

// ============================================================================
// Vineon / Compraki — regras de acesso ao Firestore
//
// PRINCIPIOS (nao afrouxar sem revisao):
//  1. Papel de admin vem EXCLUSIVAMENTE do custom claim `admin` no ID token.
//     Nunca de campo em documento que o proprio usuario possa escrever.
//  2. `users/{uid}` guarda dado pessoal (CPF, telefone, endereco) e NAO tem
//     leitura publica. O perfil publico do vendedor vive em `sellers/{uid}`,
//     espelhado por Cloud Function (functions/src/seller-profile.ts).
//  3. Toda regra de update valida `resource.data` (o documento que ja existe),
//     nao apenas `request.resource.data` (o payload que chegou).
//  4. Colecao sem match explicito é negada por padrao. Ao criar colecao nova,
//     adicionar a regra aqui — nao pelo console.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Somente custom claim. Ver functions/src/admin-claims.ts para atribuir.
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Campos que definem privilegio ou punicao: so admin encosta.
    function privilegedFields() {
      return ['isAdmin', 'super_admin', 'role', 'admin', 'isChatBanned', 'suspended'];
    }

    // Conta derrubada pelo admin (`setAccountSuspension`). O login ja fica
    // bloqueado no Auth, mas um ID token emitido antes continua valido por ate
    // 1 hora — por isso as escritas que importam conferem aqui tambem.
    function isSuspended() {
      return exists(/databases/$(database)/documents/accountSuspensions/$(request.auth.uid));
    }

    function touchesPrivileged() {
      return request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny(privilegedFields());
    }

    function chatData(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data;
    }

    function isChatParticipant(chatId) {
      let c = chatData(chatId);
      return isSignedIn() && (
        (c.participantIds is list && request.auth.uid in c.participantIds) ||
        request.auth.uid == c.buyerId ||
        request.auth.uid == c.sellerId
      );
    }

    // ---------------------------------------------------------------- produtos

    // Nota e contagem de avaliacoes: so a Cloud Function `onProductReviewWritten`
    // escreve. Com isso liberado, o vendedor gravava `rating: 5` no proprio anuncio.
    function reviewAggregateFields() {
      return ['rating', 'reviewCount', 'ratingBreakdown'];
    }

    // Campos que o vendedor nao escreve: nota agregada (funcao de avaliacoes) e
    // `moderation` (anuncio fora do ar — admin e funcao `moderateProductName`).
    function sellerLockedProductFields() {
      return reviewAggregateFields().concat(['moderation']);
    }

    match /products/{productId} {
      allow read: if true;

      allow create: if isAdmin() || (
        isSignedIn()
        && request.resource.data.sellerId == request.auth.uid
        && !request.resource.data.keys().hasAny(sellerLockedProductFields())
        && !isSuspended()
      );

      // Valida o dono ATUAL do documento e impede transferir a posse.
      allow update: if isAdmin() || (
        isSignedIn()
        && resource.data.sellerId == request.auth.uid
        && request.resource.data.sellerId == resource.data.sellerId
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(sellerLockedProductFields())
        && !isSuspended()
      );

      allow delete: if isAdmin() || (
        isSignedIn() && resource.data.sellerId == request.auth.uid
      );

      // Avaliacoes. Id do documento = uid de quem avalia (uma por pessoa).
      // Leitura publica: visitante sem conta tambem ve as opinioes.
      //
      // Aqui a regra so garante que o pedido citado e da pessoa e esta pago.
      // Se o produto esta mesmo dentro do pedido quem confere e a funcao
      // `onProductReviewWritten` (a regra nao consegue varrer `items`); se nao
      // estiver, ela apaga a avaliacao.
      match /reviews/{reviewerId} {
        allow read: if true;

        allow create: if isUser(reviewerId)
          && isValidReview()
          && ownsPaidOrder(request.resource.data.orderId)
          && get(/databases/$(database)/documents/products/$(productId)).data.sellerId != request.auth.uid;

        allow update: if isUser(reviewerId)
          && isValidReview()
          && request.resource.data.orderId == resource.data.orderId
          && request.resource.data.createdAt == resource.data.createdAt;

        allow delete: if isUser(reviewerId) || isAdmin();
      }
    }

    function isValidReview() {
      let d = request.resource.data;
      return d.keys().hasOnly(['userId', 'userName', 'rating', 'comment', 'orderId', 'createdAt', 'updatedAt'])
        && d.userId == request.auth.uid
        && d.rating is int && d.rating >= 1 && d.rating <= 5
        && d.comment is string && d.comment.size() <= 2000
        && d.userName is string && d.userName.size() <= 60
        && d.orderId is string;
    }

    function ownsPaidOrder(orderId) {
      let order = get(/databases/$(database)/documents/orders/$(orderId)).data;
      return order.userId == request.auth.uid
        && order.status in ['RECEIVED', 'CONFIRMED', 'DELIVERED', 'IN_ESCROW'];
    }

    // ------------------------------------------------------ catalogo editorial

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Ajustes que o admin muda pelo painel (aba Ajustes): frete gratis por
    // valor, termos proibidos em anuncio, redes sociais. Leitura publica — a
    // vitrine de visitante precisa. NUNCA guardar segredo aqui (isso e `settings/`).
    match /appConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ------------------------------------------------- perfil publico de loja
    // Espelho somente-leitura mantido pela Cloud Function `syncSellerProfile`.
    // Contem apenas campos de vitrine — nunca CPF, e-mail, telefone ou endereco.

    match /sellers/{sellerId} {
      allow read: if true;
      allow write: if false;
    }

    // ------------------------------------------------------------- usuarios
    // Dado pessoal. Leitura restrita ao dono e a admin.

    match /users/{userId} {
      allow read: if isUser(userId) || isAdmin();

      allow create: if isAdmin() || (
        isUser(userId)
        && !request.resource.data.keys().hasAny(privilegedFields())
      );

      allow update: if isAdmin() || (
        isUser(userId) && !touchesPrivileged()
      );

      allow delete: if isAdmin();

      // Seguidores: contagem aparece no perfil publico, entao leitura aberta.
      // O documento so guarda o vinculo, sem dado pessoal.
      match /followers/{followerId} {
        allow read: if true;
        allow create, update, delete: if isUser(followerId)
          && request.auth.uid != userId;
      }

      match /followingSellers/{sellerId} {
        allow read: if isUser(userId) || isAdmin();
        allow create, update, delete: if isUser(userId)
          && request.auth.uid != sellerId;
      }

      // Carrinho, salvos e enderecos: exclusivos do dono.
      match /cart/{itemId} {
        allow read, write: if isUser(userId);
      }

      match /savedProducts/{savedId} {
        allow read, write: if isUser(userId);
      }

      match /addresses/{addressId} {
        allow read, write: if isUser(userId);
      }
    }

    // ------------------------------------------------ consultas collection group
    // `collectionGroup()` NAO usa as regras da subcolecao: precisa de match
    // proprio com o prefixo `{path=**}`. Sao consultas de painel, so admin.
    //
    // NOTA: `StatsService.countSaves()` (src/app/services/stats.service.ts)
    // faz collectionGroup em `savedProducts` e passa a devolver 0 para o
    // vendedor comum — o try/catch de la ja trata. A correcao definitiva e o
    // contador desnormalizado `savedCount` no proprio produto (Fase 2).

    match /{path=**}/messages/{messageId} {
      allow read: if isAdmin();
    }

    match /{path=**}/savedProducts/{savedId} {
      allow read: if isAdmin();
    }

    // ---------------------------------------------------------------- chats

    match /chats/{chatId} {
      allow read: if isAdmin() || (isSignedIn() && (
        (resource.data.participantIds is list
          && request.auth.uid in resource.data.participantIds) ||
        request.auth.uid == resource.data.buyerId ||
        request.auth.uid == resource.data.sellerId
      ));

      // Quem cria precisa estar dentro da propria conversa.
      allow create: if isAdmin() || (
        isSignedIn()
        && request.resource.data.participantIds is list
        && request.auth.uid in request.resource.data.participantIds
      );

      allow update: if isAdmin() || (isSignedIn() && (
        (resource.data.participantIds is list
          && request.auth.uid in resource.data.participantIds) ||
        request.auth.uid == resource.data.buyerId ||
        request.auth.uid == resource.data.sellerId
      ));

      allow delete: if isAdmin();

      // Subcolecao NAO herda a regra do pai — a checagem precisa ser repetida.
      match /messages/{messageId} {
        allow read: if isAdmin() || isChatParticipant(chatId);

        allow create: if isAdmin() || (
          isChatParticipant(chatId)
          && request.resource.data.senderId == request.auth.uid
          && !isSuspended()
        );

        // Mensagem enviada nao se reescreve; historico e imutavel.
        allow update: if isAdmin() || (
          isChatParticipant(chatId)
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['read', 'readAt'])
        );

        allow delete: if isAdmin();
      }
    }

    // --------------------------------------------------------------- pedidos
    // Leitura para o comprador, para os vendedores envolvidos e para admin.
    // Valores financeiros so mudam via Cloud Function (Admin SDK ignora regras).

    match /orders/{orderId} {
      allow read: if isAdmin() || (isSignedIn() && (
        request.auth.uid == resource.data.userId ||
        (resource.data.sellerIds is list
          && request.auth.uid in resource.data.sellerIds)
      ));

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && !isSuspended();

      // Comprador e vendedor mexem em entrega e observacao, nunca no dinheiro
      // nem no `status`.
      //
      // `status` esta na lista porque e ele que diz se o pedido foi pago. Com
      // ele liberado, o comprador escrevia `status: 'RECEIVED'` direto pelo SDK
      // e levava o produto sem pagar — era o que o botao "SIMULAR PAGAMENTO"
      // fazia. Quem confirma pagamento e a funcao `asaasWebhook`, pelo Admin
      // SDK, que nao passa por estas regras.
      allow update: if isAdmin() || (isSignedIn()
        && (
          request.auth.uid == resource.data.userId ||
          (resource.data.sellerIds is list
            && request.auth.uid in resource.data.sellerIds)
        )
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny([
               'total', 'userId', 'sellerIds', 'items', 'asaasPaymentId',
               'coraInvoiceId', 'paymentProvider',
               'status', 'paymentAlert', 'paymentConfirmedAt', 'paymentConfirmedBy'
             ])
        // Nota fiscal / declaracao de conteudo: so a loja anexa.
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['fiscalDocuments'])
          || (resource.data.sellerIds is list && request.auth.uid in resource.data.sellerIds)
        ));

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------- denuncias

    // Denuncias de conversa (chat-box). A aba Conversas do admin lista tudo.
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Denuncias de anuncio e de vendedor (aba Denuncias do admin).
    // Id = `{targetType}_{targetId}_{uid}`: uma por pessoa por alvo. Quem
    // denunciou le a propria (o app mostra "voce ja denunciou"); o denunciado
    // nunca sabe quem foi.
    match /contentReports/{reportId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.reporterId == request.auth.uid);

      allow create: if isSignedIn()
        && !isSuspended()
        && isValidContentReport()
        && reportId == request.resource.data.targetType + '_'
             + request.resource.data.targetId + '_' + request.auth.uid;

      allow update, delete: if isAdmin();
    }

    function isValidContentReport() {
      let d = request.resource.data;
      return d.keys().hasOnly(['targetType', 'targetId', 'sellerId', 'targetName', 'targetPhoto',
                               'reason', 'details', 'reporterId', 'reporterName', 'status', 'createdAt'])
        && d.reporterId == request.auth.uid
        && d.sellerId != request.auth.uid
        && d.targetType in ['product', 'seller']
        && d.targetId is string && d.targetId.size() > 0 && d.targetId.size() <= 128
        && d.sellerId is string && d.sellerId.size() > 0
        && d.targetName is string && d.targetName.size() <= 200
        && d.reason in ['prohibited', 'fraud', 'counterfeit', 'misleading', 'offensive',
                        'no_delivery', 'abusive', 'fake_profile', 'other']
        && d.details is string && d.details.size() <= 1000
        && d.reporterName is string && d.reporterName.size() <= 80
        && d.status == 'open'
        && d.createdAt == request.time;
    }

    // Marca de conta suspensa. So a funcao `setAccountSuspension` escreve; o
    // dono le a propria.
    match /accountSuspensions/{uid} {
      allow read: if isAdmin() || isUser(uid);
      allow write: if false;
    }

    // Historico de suspensoes/reativacoes (quem, quando, por que). So o Admin SDK escreve.
    match /moderationLog/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ------------------------------------------------ operacao / diagnostico

    match /webhook_history/{entryId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Trava de idempotencia do webhook do Asaas. So o Admin SDK escreve.
    match /asaasWebhookEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Dono de cada fatura do Cora, gravado por `createCoraCharge`. So o Admin
    // SDK escreve; e por ele que o servidor confere quem pode pagar/consultar.
    match /coraCharges/{invoiceId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /whatsappMediaCache/{mediaId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /whatsappMediaCacheStats/{statsDoc} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Metricas agregadas por Cloud Function agendada (Fase 2).
    match /metrics/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ------------------------------------------------- exclusivas do Admin SDK
    // Nenhum cliente acessa. Listadas explicitamente para deixar a intencao
    // registrada, em vez de depender do deny implicito.

    match /passwordResets/{email} {
      allow read, write: if false;
    }

    match /whatsappInstances/{instanceName} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /whatsappInstanceLocks/{instanceName} {
      allow read, write: if false;
    }

    match /whatsappTriggers/{triggerId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /botJobs/{jobId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /botJobLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /whatsappDeletedInstances/{instanceName} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /whatsappTriggerLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /whatsappWebhookEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Credenciais e tokens de integracao (Melhor Envio, etc). Nunca ao cliente.
    match /settings/{docId} {
      allow read, write: if false;
    }
  }
}
